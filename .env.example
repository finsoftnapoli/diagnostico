# Copiare in .env.local (in locale) e nelle variabili d'ambiente di Vercel. Mai su GitHub.

# Supabase: Project Settings > API Keys
# NEXT_PUBLIC_SUPABASE_ANON_KEY = chiave "publishable" (o "anon"); SUPABASE_SERVICE_ROLE_KEY = chiave "secret" (o "service_role")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server: scrive risposte definitive e punteggi
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Console Anthropic): lettura di visura, bilancio e altri documenti, prima stesura dei report
ANTHROPIC_API_KEY=

# Email del servizio (Resend). Mittente: se vuoto "Diagnostico d'impresa <diagnostico@finsoft.biz>"
RESEND_API_KEY=
RESEND_FROM=
# Email di accesso inviate dal sito (Supabase > Authentication > Auth Hooks > Send Email Hook, HTTPS,
# indirizzo <sito>/api/auth/email): il segreto "v1,whsec_..." generato da Supabase
SEND_EMAIL_HOOK_SECRET=

# Attività pianificate di Vercel (report in differita alle 7:00, pulizia alle 3:30): stringa casuale lunga
CRON_SECRET=

# Verifica "persona e non bot" (Cloudflare Turnstile): dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Avvisi allo staff (richieste, report da rivedere, ordini, prenotazioni); se vuoto si usa info@finsoft.biz
STAFF_NOTIFY_EMAIL=
# Indirizzo pubblico del sito (es. https://www.dominio.it): link canonici, sitemap, anteprime social, link nelle email
PUBLIC_SITE_URL=

# Pagamenti (Stripe): dashboard.stripe.com > Sviluppatori. In prova usare le chiavi sk_test_...
STRIPE_SECRET_KEY=
# Endpoint del webhook: https://<sito>/api/stripe/webhook con gli eventi checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# Dati di Finsoft per la fattura elettronica (cedente). Gli stessi dati, per esteso, vanno in src/config/brand.ts
# (ownerAddress, ownerVat, ownerPec), che li mostra in informativa e condizioni di vendita.
SELLER_DENOMINAZIONE=Finsoft S.r.l.
SELLER_VAT=
SELLER_TAX_CODE=
SELLER_ADDRESS=
SELLER_CAP=
SELLER_CITY=
SELLER_PROVINCE=
SELLER_REGIME=RF01
SELLER_REA_UFFICIO=
SELLER_REA_NUMERO=
SELLER_CAPITALE=
SELLER_SOCIO_UNICO=
# Sezionale delle fatture del servizio (numeri tipo 1/DIA): da concordare con il commercialista
INVOICE_SERIES=DIA

# Aruba Fatturazione Elettronica con accesso API: ARUBA_ENV=demo per l'ambiente di prova, prod per l'invio reale
ARUBA_USERNAME=
ARUBA_PASSWORD=
ARUBA_ENV=demo

# Collegamento predefinito alle videochiamate di consulenza (per esempio una stanza Google Meet)
DEFAULT_MEETING_URL=

# Report: modello usato per scrivere e rileggere i report (facoltativo) e rilascio automatico.
# Con REPORT_AUTO_RELEASE=0 ogni report attende l'approvazione dello staff; altrimenti parte da solo
# quando supera i controlli e la seconda lettura.
REPORT_MODEL=
REPORT_AUTO_RELEASE=

# Promemoria automatici (bozza lasciata a metà dopo 2 giorni, invito senza risposta dopo 5): REMINDERS=0 li disattiva
REMINDERS=
