# Copiare in .env.local (in locale) e nelle variabili d'ambiente di Vercel. Mai su GitHub.

# Supabase: Project Settings > API Keys
# NEXT_PUBLIC_SUPABASE_ANON_KEY = chiave "publishable" (o "anon"); SUPABASE_SERVICE_ROLE_KEY = chiave "secret" (o "service_role")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server: scrive risposte definitive e punteggi
SUPABASE_SERVICE_ROLE_KEY=

# Fase 2: testo del report
ANTHROPIC_API_KEY=

# Email (Resend)
RESEND_API_KEY=

# Analytics (PostHog, regione UE)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Verifica "persona e non bot" (Cloudflare Turnstile): dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Avvisi allo staff (richieste, report da rivedere, ordini, prenotazioni); se vuoto si usa info@finsoft.biz
STAFF_NOTIFY_EMAIL=
# Indirizzo pubblico del sito, usato nei link delle email inviate dai pagamenti
PUBLIC_SITE_URL=

# Pagamenti (Stripe): dashboard.stripe.com > Sviluppatori. In prova usare le chiavi sk_test_...
STRIPE_SECRET_KEY=
# Endpoint del webhook: https://<sito>/api/stripe/webhook con gli eventi checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# Dati di Finsoft per la fattura elettronica (cedente)
SELLER_DENOMINAZIONE=Finsoft S.r.l.
SELLER_VAT=
SELLER_TAX_CODE=
SELLER_ADDRESS=
SELLER_CAP=
SELLER_CITY=
SELLER_PROVINCE=
SELLER_REGIME=RF01
SELLER_REA_UFFICIO=
SELLER_REA_NUMERO=
SELLER_CAPITALE=
SELLER_SOCIO_UNICO=
# Sezionale delle fatture del servizio (numeri tipo 1/DIA): da concordare con il commercialista
INVOICE_SERIES=DIA

# Aruba Fatturazione Elettronica con accesso API: ARUBA_ENV=demo per l'ambiente di prova, prod per l'invio reale
ARUBA_USERNAME=
ARUBA_PASSWORD=
ARUBA_ENV=demo

# Collegamento predefinito alle videochiamate di consulenza (per esempio una stanza Google Meet)
DEFAULT_MEETING_URL=
